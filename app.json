{
  "expo": {
    "name": "FauxGo",
    "slug": "fauxgo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/fauxgo-icon.png",
    "scheme": "fauxgo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fauxgo-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.kaizunlabs.fauxgo"
    },
    "android": {
      "icon": "./assets/images/fauxgo-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#C94332",
        "foregroundImage": "./assets/images/fauxgo-adaptive-foreground.png",
        "monochromeImage": "./assets/images/fauxgo-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.kaizunlabs.fauxgo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFBF8",
          "image": "./assets/images/fauxgo-splash.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#171716",
            "image": "./assets/images/fauxgo-splash-dark.png"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FauxGo uses your foreground location to set a pickup or delivery point for entertainment simulations. You can choose a place manually instead.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-localization",
      "expo-asset"
    ],
    "extra": {
      "simulationOnly": true,
      "realWorldTransactionsEnabled": false
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
