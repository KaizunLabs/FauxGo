# Public client configuration. Never place secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=
EXPO_PUBLIC_ROUTING_MODE=demo
EXPO_PUBLIC_ROUTING_BASE_URL=
# HTTPS OSRM-compatible root; set ROUTING_MODE=osrm to enable. No demo public server is assumed production-ready.
# HTTPS Photon-compatible root. Search is explicit-submit and never sends a device-location bias.
EXPO_PUBLIC_GEOCODING_BASE_URL=

# Optional advertising. Keep disabled until consent, publisher accounts, and store metadata are ready.
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADSENSE_CLIENT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_HOME_UNIT_ID=
EXPO_PUBLIC_ADMOB_COMPLETION_UNIT_ID=

# Optional guest-to-account sync. The anon key is designed for clients; never add the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
