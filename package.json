{
  "name": "fauxgo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "A polished cross-platform simulation of modern on-demand experiences. Nothing real is ordered, booked, or charged.",
  "license": "MIT",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "maplibre-gl": "^6.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "prepare:maps": "node scripts/prepare-map-worker.mjs",
    "photos:fetch": "node scripts/fetch-pexels-assets.mjs",
    "photos:optimize": "node scripts/optimize-photography.mjs",
    "photos:report": "tsx scripts/report-photo-coverage.ts",
    "photos:prepare": "npm run photos:fetch && npm run photos:optimize && npm run photos:report",
    "prestart": "npm run prepare:maps",
    "preweb": "npm run prepare:maps",
    "prebuild:web": "npm run prepare:maps",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:jsx": "node scripts/check-native-text-nodes.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "build:web": "expo export --platform web",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,js,md}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,js,md}\" \"docs/**/*.md\" \".github/**/*.yml\"",
    "verify": "npm run format:check && npm run check:jsx && npm run typecheck && npm run lint && npm test && npm run build:web"
  },
  "private": false,
  "engines": {
    "node": ">=22.13"
  }
}
